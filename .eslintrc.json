    //            "position": "after"
    //          }
    //        ],
    //        "pathGroupsExcludedImportTypes": [
    //          "internal"
    //        ],
    //        "alphabetize": {
    //          "order": "asc",
    //          "caseInsensitive": true
    //        }
    //      }
    //    ]
  },
  "ignorePatterns": ["databaseTypesFile.ts"]
}
